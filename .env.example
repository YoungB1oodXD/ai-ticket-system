# ========================================
# n8n AI Ticket System — 环境变量模板
# 复制此文件为 .env 并填入真实值
# ========================================

# ---------- OpenAI / LLM ----------
# OpenAI 兼容 API 的凭证 ID 和名称（在 n8n 中创建）
OPENAI_CREDENTIAL_ID=your_openai_credential_id
OPENAI_CREDENTIAL_NAME=OpenAI account

# ---------- Webhook ----------
# n8n Webhook 的唯一 ID（工作流激活后自动生成）
WEBHOOK_ID=your_webhook_id
# Webhook 等待节点 ID
WAIT_WEBHOOK_ID=your_wait_webhook_id
# Header Auth 凭证（在 n8n 中创建）
HEADER_AUTH_CREDENTIAL_ID=your_header_auth_credential_id
HEADER_AUTH_CREDENTIAL_NAME=Header Auth account

# ---------- 飞书 Feishu ----------
# 飞书应用凭证（从飞书开发者后台获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
# 飞书多维表格
FEISHU_APP_TOKEN=your_app_token
FEISHU_TABLE_ID=your_table_id
# 飞书群聊 ID
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- SMTP 邮件 ----------
# 发件邮箱（用于自动回复客户）
SMTP_FROM_EMAIL=sender@example.com
SMTP_TO_EMAIL=recipient@example.com
# SMTP 凭证（在 n8n 中创建）
SMTP_CREDENTIAL_ID=your_smtp_credential_id
SMTP_CREDENTIAL_NAME=SMTP account

# ---------- RagFlow 知识库 ----------
# RagFlow API Key 和数据集 ID
RAGFLOW_API_KEY=ragflow-your-api-key
RAGFLOW_DATASET_ID=your_dataset_id

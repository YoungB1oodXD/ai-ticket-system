        "jsCode": "const data = $input.first().json;\n\nreturn [{\n  json: {\n    '=== 原始 AI 输出 ===': data.aiAnalysis,\n    'can_be_auto_replied 值': data.aiAnalysis?.can_be_auto_replied,\n    'can_be_auto_replied 类型': typeof data.aiAnalysis?.can_be_auto_replied,\n    'urgency 值': data.aiAnalysis?.true_urgency,\n    'category 值': data.aiAnalysis?.category,\n    'sentiment 值': data.aiAnalysis?.sentiment,\n    'requires_immediate 值': data.aiAnalysis?.requires_immediate_human_intervention,\n    '=== 决策结果 ===': {\n      action_required: data.action_required,\n      action_reason: data.action_reason\n    },\n    '=== 完整数据 ===': data\n  }\n}];"

    {
      "parameters": {
        "jsCode": "\n  const aiAnalysis = $input.first().json.output;\n  const originalData = $('接收POST请求').first().json.body;\n\n  // 校验\n  const validCategories = ['billing', 'technical', 'feature_request', 'bug', 'general'];\n  const validUrgencies = ['critical', 'high', 'medium', 'low'];\n  const category = validCategories.includes(aiAnalysis.category) ? aiAnalysis.category : 'general';\n  const urgency = validUrgencies.includes(aiAnalysis.true_urgency) ? aiAnalysis.true_urgency : 'medium';\n\n  // 决策逻辑（三层）\n  let action = 'normal';\n  let actionReason = '';\n\n  // 第一层：紧急\n  if (aiAnalysis.requires_immediate_human_intervention ||\n      urgency === 'critical' ||\n      (urgency === 'high' && category !== 'general') ||\n      aiAnalysis.sentiment === 'angry') {\n    action = 'urgent';\n    actionReason = '紧急情况，需要人工立即介入';\n\n  // 第二层：可以自动回复\n  } else if (aiAnalysis.can_be_auto_replied === true) {\n    action = 'auto_reply';\n    actionReason = '常规咨询，AI自动回复即可';\n\n  // 第三层：常规\n  } else {\n    action = 'normal';\n    actionReason = '常规工单，待人工处理';\n  }\n\n  return [{\n    json: {\n      originalData,\n      aiAnalysis: {\n        ...aiAnalysis,\n        category,\n        true_urgency: urgency\n      },\n      received_at: new Date().toISOString(),\n      ticket_id: 'TKT' + Date.now().toString(36).toUpperCase(),\n      action_required: action,\n      action_reason: actionReason\n    }\n  }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        384
      ],

    {
      "parameters": {
        "jsCode": "// 获取用户问题\nconst originalData = $input.first().json.originalData || {};\nconst question = (originalData.issue_title + ' ' + originalData.issue_description).toLowerCase();\n\n// 获取检索结果\nconst chunks = $input.first().json.data?.chunks || [];\n\n// 提取问题关键词\nconst keywords = {\n  password: ['密码', 'password', '重置', 'reset', '忘记', 'forgot', '登录'],\n  register: ['注册', '开户', 'account', '邮箱'],\n  payment: ['支付', '付款', '发票', '账单', '退款'],\n  // 根据常见问题扩展\n};\n\n// 自动检测问题类型\nlet questionType = 'general';\nfor (const [type, words] of Object.entries(keywords)) {\n  if (words.some(w => question.includes(w))) {\n    questionType = type;\n    break;\n  }\n}\n\n// 智能提取相关段落\nfunction extractRelevantSection(content, type) {\n  // 按章节分割\n  const sections = content.split(/(?=^##|^###)/m);\n  \n  // 根据问题类型筛选相关章节\n  const relevantSections = sections.filter(section => {\n    if (type === 'password') {\n      return section.includes('密码') || section.includes('登录') || section.includes('重置');\n    }\n    if (type === 'register') {\n      return section.includes('注册') || section.includes('账户');\n    }\n    // 默认返回前 300 字符\n    return true;\n  });\n  \n  // 返回相关章节，限制长度\n  return relevantSections.slice(0, 2).map(s => s.trim()).join('\\n\\n').substring(0, 800);\n}\n\n// 构建知识库上下文（只取最相关的 3 个 chunk 的相关段落）\nconst knowledgeContext = chunks.slice(0, 5).map((chunk, i) => {\n  const relevantContent = extractRelevantSection(chunk.content, questionType);\n  return `【知识库参考 ${i+1}】来源：${chunk.document_keyword}\n相似度：${(chunk.similarity * 100).toFixed(1)}%\n内容：${relevantContent || chunk.content.substring(0, 400)}\n---`;\n}).filter((_, i) => i < 3).join('\\n\\n');\n\n// 判断检索质量\nconst hasKnowledge = chunks.length > 0 && chunks[0]?.similarity > 0.35;\n\nconsole.log(' 问题类型:', questionType);\nconsole.log('📚 Chunks 数量:', chunks.length);\nconsole.log('✅ 最高相似度:', chunks[0]?.similarity?.toFixed(3));\n\nreturn [{\n  json: {\n    originalData: originalData,\n    knowledge_context: knowledgeContext,\n    has_knowledge: hasKnowledge,\n    chunks_count: chunks.length,\n    top_similarity: chunks[0]?.similarity || 0,\n    question_type: questionType\n  }\n}];"
      },
